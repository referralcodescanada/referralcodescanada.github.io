---
// Grid of short cards: icon + title + text (home page "How this site works", optional product features).
import type { IconName } from '../../lib/icons.ts';
import Icon from './Icon.astro';
import Md from './Md.astro';
interface Props {
  items: { icon: IconName; title: string; text: string }[];
}
const { items } = Astro.props;
---
<ul class="features">{items.map((f) => <li class="card feature"><span class="feature__icon"><Icon name={f.icon} /></span><h3><Md text={f.title} /></h3><p><Md text={f.text} /></p></li>)}</ul>

<style is:global>
  .features{list-style:none;display:grid;gap:18px;margin:0;padding:0}
  @media (min-width:700px){.features{grid-template-columns:repeat(2,1fr)}}
  @media (min-width:1020px){.features{grid-template-columns:repeat(3,1fr)}}
  .feature{padding:26px}
  .feature p{margin:0;color:var(--muted);font-size:.98rem}
</style>
