---
// Numbered step cards + their schema.org HowTo (same text for visitors and for Google).
import { jsonLd } from '../../lib/format.ts';
import { howToNode, type HowToInput } from '../../lib/jsonld.ts';
import Md from './Md.astro';
interface Props {
  items: { title: string; text: string }[];
  /** Structured data for these steps (omit to render the cards only). */
  howTo?: Omit<HowToInput, 'steps'>;
}
const { items, howTo } = Astro.props;
const data = howTo && { '@context': 'https://schema.org', ...howToNode({ ...howTo, steps: items }) };
---
<ol class="steps">{items.map((s, i) => <li class="step card" id={`step-${i + 1}`}><h3><Md text={s.title} /></h3><p><Md text={s.text} /></p></li>)}</ol>
{data && <script type="application/ld+json" is:inline set:html={jsonLd(data)} />}

<style is:global>
  .steps{list-style:none;display:grid;gap:18px;margin:0;padding:0;counter-reset:step}
  @media (min-width:700px){.steps{grid-template-columns:repeat(2,1fr)}}
  @media (min-width:1080px){.steps{grid-template-columns:repeat(4,1fr)}}
  .step{position:relative;padding:28px 24px 24px;counter-increment:step;transition:transform .2s ease,box-shadow .2s ease}
  .step:hover{transform:translateY(-4px);box-shadow:0 24px 40px -30px color-mix(in srgb,var(--ink) 50%,transparent)}
  .step::before{content:counter(step);display:grid;place-items:center;width:44px;height:44px;margin-bottom:20px;border-radius:14px;background:var(--brand);color:var(--brand-ink);font:700 1.15rem var(--font-display)}
  .step:last-child::before{background:var(--accent);color:var(--accent-ink)}
  .step p{margin:0;color:var(--muted);font-size:.98rem}
  .step p strong,.step p a{color:var(--ink)}
</style>
