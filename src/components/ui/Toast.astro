---
// Short confirmation message ("Code 6QL89Q copied"), shown by CopyButton.
---
<div class="toast" role="status" aria-live="polite"></div>

<style is:global>
  .toast{position:fixed;left:50%;top:84px;z-index:50;padding:10px 18px;white-space:nowrap;border-radius:999px;background:var(--brand);color:var(--brand-ink);font-weight:600;font-size:.92rem;box-shadow:0 14px 30px -12px rgba(0,0,0,.4);opacity:0;transform:translate(-50%,-10px);pointer-events:none;transition:opacity .2s,transform .2s}
  .toast.is-on{opacity:1;transform:translate(-50%,0)}
</style>
