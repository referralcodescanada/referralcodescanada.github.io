---
// "Copy" button for a referral code: copies it, shows a toast, throws a few coins and spins the header logo.
import { interpolate } from '../../lib/format.ts';
import type { UiStrings } from '../../lib/i18n.ts';
import Icon from './Icon.astro';
interface Props {
  code: string;
  ui: UiStrings;
  variant?: 'default' | 'ghost' | 'sm';
}
const { code, ui, variant = 'default' } = Astro.props;
const cls = ['copy', variant !== 'default' && `copy--${variant}`].filter(Boolean).join(' ');
---
<button class={cls} type="button" data-copy={code} data-copied={ui.copied} data-toast={interpolate(ui.copiedToast, { code })} aria-label={`${ui.copy} ${code}`}><Icon name="copy" /><span data-label={ui.copy}>{ui.copy}</span></button>

<style is:global>
  .copy{display:inline-flex;align-items:center;gap:8px;min-height:48px;padding:0 18px;border-radius:999px;border:0;background:var(--accent);color:var(--accent-ink);font:inherit;font-weight:650;cursor:pointer;transition:transform .15s ease,background .2s}
  .copy:hover{transform:scale(1.03)}
  .copy:active{transform:scale(.97)}
  .copy.is-copied{background:var(--brand);color:var(--brand-ink)}
  .copy--ghost{background:var(--surface);color:var(--ink);border:1.5px solid var(--line);min-height:52px}
  .copy--sm{min-height:40px;padding:0 14px;font-size:.9rem}
  /* Coins thrown by src/lib/effects/coin-burst.ts */
  .coinlet{position:fixed;z-index:25;width:var(--s);height:var(--s);margin:calc(var(--s) / -2) 0 0 calc(var(--s) / -2);display:grid;place-items:center;border-radius:50%;background:var(--coin-gold);box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.45),inset 0 0 0 2.5px rgba(120,80,10,.5),0 4px 10px -4px rgba(0,0,0,.45);color:#6e4a0c;font:800 calc(var(--s) * .6)/1 var(--font-display);pointer-events:none;will-change:transform}
</style>

<script>
  import { coinBurst, reducedMotion } from '../../lib/effects/coin-burst.ts';
  import { track } from '../../lib/track.ts';

  const copyText = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;opacity:0;top:0';
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch {
        // not supported
      }
      ta.remove();
      return ok;
    }
  };

  let timer: ReturnType<typeof setTimeout> | undefined;
  const showToast = (msg?: string) => {
    const toast = document.querySelector('.toast');
    if (!toast || !msg) return;
    toast.textContent = msg;
    toast.classList.add('is-on');
    clearTimeout(timer);
    timer = setTimeout(() => toast.classList.remove('is-on'), 2000);
  };

  const spinLogos = () => {
    if (reducedMotion()) return;
    document.querySelectorAll('.logo__coin').forEach((c) =>
      c.animate([{ transform: 'rotateY(0)' }, { transform: 'rotateY(2turn)' }], { duration: 1400, easing: 'cubic-bezier(.2,.7,.2,1)' }),
    );
  };

  // One listener for every copy button of the page (event delegation).
  document.addEventListener('click', async (e) => {
    const btn = (e.target as Element | null)?.closest<HTMLElement>('[data-copy]');
    if (!btn || !(await copyText(btn.dataset.copy || ''))) return;
    track('copy-code');
    const r = btn.getBoundingClientRect();
    coinBurst(r.left + r.width / 2, r.top + r.height / 2, 12, 700);
    spinLogos();
    const label = btn.querySelector<HTMLElement>('[data-label]');
    btn.classList.add('is-copied');
    if (label) label.textContent = btn.dataset.copied || '';
    showToast(btn.dataset.toast);
    setTimeout(() => {
      btn.classList.remove('is-copied');
      if (label) label.textContent = label.dataset.label || '';
    }, 2000);
  });
</script>
