---
// Illustrative phone screen (not a real app screenshot) showing the bonus landing, plus a round sticker.
import Icon from './Icon.astro';
interface Props {
  account: string;
  balanceLabel: string;
  balance: string;
  notifTitle: string;
  notifBody: string;
  amount: string;
  rows?: { label: string; value: string }[];
  sticker?: string;
  stickerSub?: string;
}
const m = Astro.props;
---
<div class="art">
  <div class="phone">
    <div class="phone__screen">
      <span class="phone__notch"></span>
      <div class="phone__top"><span>{m.account}</span><span class="phone__avatar"></span></div>
      <div><div class="phone__label">{m.balanceLabel}</div><div class="phone__balance">{m.balance}</div></div>
      <div class="notif"><span class="notif__icon"><Icon name="gift" /></span><span class="notif__txt"><strong>{m.notifTitle}</strong><small>{m.notifBody}</small></span><span class="notif__amt">{m.amount}</span></div>
      <ul class="prows">{(m.rows || []).map((r) => <li><span>{r.label}</span><b>{r.value}</b></li>)}</ul>
      <span class="phone__bar"></span>
    </div>
  </div>
  {m.sticker && <div class="sticker"><b>{m.sticker}</b><span>{m.stickerSub || ''}</span></div>}
</div>

<style is:global>
  .art{position:relative;max-width:360px;margin-inline:auto;padding:12px 18px}
  .phone{position:relative;aspect-ratio:9/18.4;padding:11px;border-radius:48px;background:#101112;box-shadow:0 0 0 1.5px color-mix(in srgb,var(--line) 60%,transparent),0 50px 90px -40px rgba(0,0,0,.55),inset 0 0 0 2px #2a2b2e;transform:rotate(3deg);animation:float 7s ease-in-out infinite}
  @keyframes float{50%{transform:rotate(3deg) translateY(-10px)}}
  .phone__screen{position:relative;height:100%;overflow:hidden;display:flex;flex-direction:column;gap:18px;padding:46px 18px 22px;border-radius:38px;background:var(--bg)}
  .phone__notch{position:absolute;top:12px;left:50%;width:92px;height:26px;margin-left:-46px;border-radius:20px;background:#101112}
  .phone__top{display:flex;align-items:center;justify-content:space-between;font-weight:650}
  .phone__avatar{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--highlight))}
  .phone__label{font-size:.8rem;color:var(--muted)}
  .phone__balance{font:700 2.1rem/1.1 var(--font-display);letter-spacing:-.02em}
  .notif{display:flex;align-items:center;gap:12px;padding:13px;border-radius:18px;background:var(--surface);box-shadow:0 14px 30px -18px rgba(0,0,0,.4);animation:pop .7s .5s cubic-bezier(.2,1.4,.4,1) both}
  @keyframes pop{from{opacity:0;transform:translateY(16px) scale(.94)}}
  .notif__icon{display:grid;place-items:center;width:40px;height:40px;flex:none;border-radius:12px;background:var(--accent);color:var(--accent-ink)}
  .notif__txt{display:flex;flex-direction:column;min-width:0;font-size:.86rem;line-height:1.3}
  .notif__txt small{color:var(--muted)}
  .notif__amt{margin-left:auto;font-weight:750;color:var(--accent);white-space:nowrap}
  .prows{list-style:none;margin:0;padding:0;font-size:.84rem}
  .prows li{display:flex;justify-content:space-between;gap:10px;padding:11px 2px;border-bottom:1px solid var(--line)}
  .prows span{color:var(--muted)}
  .prows b{font-weight:650}
  .phone__bar{margin-top:auto;align-self:center;width:110px;height:5px;border-radius:5px;background:var(--ink);opacity:.8}
  .sticker{position:absolute;bottom:13%;left:-16px;display:grid;place-items:center;align-content:center;width:112px;height:112px;border-radius:50%;background:var(--highlight);color:#141414;transform:rotate(-12deg);box-shadow:0 18px 30px -16px rgba(0,0,0,.45);animation:pop .7s .9s cubic-bezier(.2,1.4,.4,1) both}
  .sticker b{font:800 2rem/1 var(--font-display)}
  .sticker span{font-size:.78rem;font-weight:650;text-transform:uppercase;letter-spacing:.08em}
</style>
