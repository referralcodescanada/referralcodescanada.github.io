---
// Small network logo (header, footer): a coin that flips to its gold "$" side on hover.
// The parent link gets the .logo class (perspective + hover trigger).
interface Props {
  src: string;
  lazy?: boolean;
}
const { src, lazy = false } = Astro.props;
---
<span class="logo__coin" aria-hidden="true"><img src={src} alt="" width="36" height="36" loading={lazy ? 'lazy' : undefined} /></span>

<style is:global>
  .logo{perspective:320px}
  .logo__coin{position:relative;flex:none;width:36px;height:36px;transform-style:preserve-3d;transition:transform .9s cubic-bezier(.2,.75,.25,1)}
  .logo__coin img{position:absolute;inset:0;width:100%;height:100%;border-radius:50%;-webkit-backface-visibility:hidden;backface-visibility:hidden;transform:translateZ(1.5px)}
  .logo__coin::before,.logo__coin::after{content:"";position:absolute;inset:0;border-radius:50%;background:var(--coin-gold)}
  .logo__coin::after{content:"$";display:grid;place-items:center;color:#6e4a0c;font:800 19px/1 var(--font-display);box-shadow:inset 0 0 0 2.5px rgba(255,255,255,.35),inset 0 0 0 3.5px rgba(110,72,8,.45);-webkit-backface-visibility:hidden;backface-visibility:hidden;transform:rotateY(180deg) translateZ(1.5px)}
  .logo:hover .logo__coin,.logo:focus-visible .logo__coin{transform:rotateY(1turn)}
</style>
