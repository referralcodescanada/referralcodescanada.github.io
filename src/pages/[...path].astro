---
// Every HTML page of the site (home, products, guides, redirects), from the single list in src/lib/routes.ts.
import GuidePage from '../layouts/GuidePage.astro';
import HubPage from '../layouts/HubPage.astro';
import ProductPage from '../layouts/ProductPage.astro';
import { getModel } from '../lib/data.ts';
import { esc } from '../lib/format.ts';
import { pageRoutes, param, type Route } from '../lib/routes.ts';

export async function getStaticPaths() {
  const model = await getModel();
  return pageRoutes(model).map((route) => ({ params: { path: param(route.path) }, props: { route } }));
}

const { route } = Astro.props as { route: Route };
const model = await getModel();
const product = 'slug' in route ? model.products.find((p) => p.slug === route.slug)! : undefined;
// Removed page: permanent redirect for search engines (meta refresh 0 + canonical), no layout.
const stub = (to: string) =>
  `<!doctype html><html><head><meta charset="utf-8"><title>Redirecting…</title><meta name="robots" content="noindex"><link rel="canonical" href="${esc(to)}"><meta http-equiv="refresh" content="0; url=${esc(to)}"></head><body><a href="${esc(to)}">${esc(to)}</a></body></html>\n`;
---
{route.kind === 'hub' && <HubPage model={model} loc={route.loc} />}
{route.kind === 'product' && <ProductPage model={model} product={product!} loc={route.loc} />}
{route.kind === 'guide' && <GuidePage model={model} product={product!} guideId={route.guide} loc={route.loc} />}
{route.kind === 'redirect' && <Fragment set:html={stub(route.to)} />}
